rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Shared study materials and test papers
    match /materials/{materialId} {
      allow read: if true;
      allow create, update, delete: if isValidId(materialId);

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isValidId(materialId) && isValidId(chunkId);
      }
    }

    // Quizzes & predicted questions
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isValidId(quizId);
    }

    // Test records
    match /testRecords/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // Class forum posts
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isValidId(postId);
    }

    // Custom subjects
    match /customSubjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isValidId(subjectId);
    }

    // Quiz submissions
    match /quizSubmissions/{subId} {
      allow read: if true;
      allow create, update, delete: if isValidId(subId);
    }

    // Student account profiles & passwords
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    // Student created test predictions
    match /student_predictions/{predictionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(predictionId);

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isValidId(predictionId) && isValidId(chunkId);
      }
    }

    // Periodic test schedules for countdown
    match /periodicTests/{testId} {
      allow read: if true;
      allow create, update, delete: if isValidId(testId);
    }

    // Anonymous per-test leaderboards (TOP-N queried via orderBy + limit)
    match /testLeaderboards/{testId} {
      allow read: if true;
      allow create, update: if isValidId(testId)
        && request.resource.data.keys().hasAll(['id', 'testTitle'])
        && request.resource.data.testTitle is string
        && request.resource.data.testTitle.size() <= 128;
      allow delete: if isValidId(testId);

      match /entries/{entryId} {
        allow read: if true;
        allow create, update: if isValidId(testId) && isValidId(entryId)
          && !request.resource.data.keys().hasAny(['studentNumber', 'attendanceNumber', 'nickname', 'name'])
          && request.resource.data.keys().hasAll(['score', 'maxScore', 'scoreRate'])
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.maxScore is number
          && request.resource.data.maxScore >= 1
          && request.resource.data.scoreRate is number;
        allow delete: if isValidId(testId) && isValidId(entryId);
      }
    }

    // Anonymous per-test growth leaderboards (TOP-N queried via orderBy + limit)
    match /growthLeaderboards/{testId} {
      allow read: if true;
      allow create, update: if isValidId(testId)
        && request.resource.data.keys().hasAll(['id', 'testTitle'])
        && request.resource.data.testTitle is string
        && request.resource.data.testTitle.size() <= 128;
      allow delete: if isValidId(testId);

      match /entries/{entryId} {
        allow read: if true;
        allow create, update: if isValidId(testId) && isValidId(entryId)
          && !request.resource.data.keys().hasAny(['studentNumber', 'attendanceNumber', 'nickname', 'name'])
          && request.resource.data.keys().hasAll(['delta', 'rateDelta'])
          && request.resource.data.delta is number
          && request.resource.data.rateDelta is number;
        allow delete: if isValidId(testId) && isValidId(entryId);
      }
    }

    // Tombstones for deleted periodic tests
    match /deletedTests/{testId} {
      allow read: if true;
      allow create, update: if isValidId(testId)
        && request.resource.data.keys().hasAll(['id', 'title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 128;
      allow delete: if isValidId(testId);
    }
  }
}
