{
  "entities": {
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Shared test papers and study materials for class 1-8",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "fileType": { "type": "string", "enum": ["pdf", "image", "summary"] },
        "fileSize": { "type": "string", "maxLength": 32 },
        "authorNickname": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 32 },
        "downloadCount": { "type": "number" },
        "contentPreview": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 2000000 },
        "pdfUrl": { "type": "string", "maxLength": 2000000 },
        "isChunked": { "type": "boolean" },
        "totalChunks": { "type": "number" },
        "chunkedField": { "type": "string", "enum": ["imageUrl", "pdfUrl"] },
        "mimeType": { "type": "string", "maxLength": 64 },
        "documentSections": { "type": "array" }
      },
      "required": ["id", "title", "subject", "fileType", "createdAt"]
    },
    "MaterialChunk": {
      "title": "MaterialChunk",
      "description": "Ordered 700,000-character Base64 chunk for files up to 5MB stored in Firestore free tier",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 750000 }
      },
      "required": ["index", "data"]
    },
    "WeeklyQuiz": {
      "title": "WeeklyQuiz",
      "description": "Weekly mini quiz and periodic predicted questions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "category": { "type": "string" },
        "weekLabel": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "durationMinutes": { "type": "number" },
        "questions": { "type": "array" }
      },
      "required": ["id", "title", "category", "questions"]
    },
    "TestRecord": {
      "title": "TestRecord",
      "description": "Anonymous score records for tests with per-subject max scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "testTitle": { "type": "string", "maxLength": 128 },
        "testDate": { "type": "string", "maxLength": 32 },
        "studentNumber": { "type": "number" },
        "scores": { "type": "object" },
        "maxScores": { "type": "object" },
        "subjectDetails": { "type": "array" },
        "totalScore": { "type": "number" },
        "totalMaxScore": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "testTitle", "studentNumber", "totalScore"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Class 1-8 discussion and study Q&A posts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentNumber": { "type": "number" },
        "authorNickname": { "type": "string", "maxLength": 64 },
        "subjectTag": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 32 },
        "createdAtMs": { "type": "number" },
        "reactions": { "type": "object" },
        "comments": { "type": "array" }
      },
      "required": ["id", "authorNickname", "title", "content"]
    },
    "PeriodicTestSchedule": {
      "title": "PeriodicTestSchedule",
      "description": "Registered periodic test names and exam dates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "title", "date"]
    },
    "Student": {
      "title": "Student",
      "description": "Student and teacher profiles, nicknames, passwords, and roles",
      "type": "object",
      "properties": {
        "attendanceNumber": { "type": "number" },
        "nickname": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 64 },
        "hasCustomPassword": { "type": "boolean" },
        "avatarColor": { "type": "string", "maxLength": 16 },
        "role": { "type": "string", "enum": ["student", "teacher"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["attendanceNumber", "nickname"]
    },
    "TestLeaderboardMeta": {
      "title": "TestLeaderboardMeta",
      "description": "Metadata for an anonymous periodic test leaderboard",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "testTitle": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "testTitle"]
    },
    "TestLeaderboardEntry": {
      "title": "TestLeaderboardEntry",
      "description": "Anonymous score entry in a per-test leaderboard (contains NO student identity)",
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "scoreRate": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["score", "maxScore", "scoreRate"]
    },
    "GrowthLeaderboardEntry": {
      "title": "GrowthLeaderboardEntry",
      "description": "Anonymous growth entry in a per-test growth leaderboard (contains NO student identity)",
      "type": "object",
      "properties": {
        "delta": { "type": "number" },
        "rateDelta": { "type": "number" },
        "hasDifferentMax": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["delta", "rateDelta"]
    }
  },
  "firestore": {
    "/materials/{materialId}": {
      "schema": "StudyMaterial",
      "description": "Shared study materials and test papers across devices"
    },
    "/materials/{materialId}/chunks/{chunkId}": {
      "schema": "MaterialChunk",
      "description": "Chunked Base64 file segments for materials over 700KB"
    },
    "/student_predictions/{predictionId}": {
      "schema": "StudyMaterial",
      "description": "Student-created predicted test papers"
    },
    "/student_predictions/{predictionId}/chunks/{chunkId}": {
      "schema": "MaterialChunk",
      "description": "Chunked Base64 file segments for student predictions over 700KB"
    },
    "/quizzes/{quizId}": {
      "schema": "WeeklyQuiz",
      "description": "Quizzes and predicted test questions"
    },
    "/testRecords/{recordId}": {
      "schema": "TestRecord",
      "description": "Private student test scores (queried only by logged-in studentNumber)"
    },
    "/testLeaderboards/{testId}": {
      "schema": "TestLeaderboardMeta",
      "description": "Per-test anonymous leaderboard metadata"
    },
    "/testLeaderboards/{testId}/entries/{entryId}": {
      "schema": "TestLeaderboardEntry",
      "description": "Anonymous score entries queried with server-side orderBy + limit(PUBLIC_TOP_LIMIT)"
    },
    "/growthLeaderboards/{testId}": {
      "schema": "TestLeaderboardMeta",
      "description": "Per-test anonymous growth leaderboard metadata"
    },
    "/growthLeaderboards/{testId}/entries/{entryId}": {
      "schema": "GrowthLeaderboardEntry",
      "description": "Anonymous growth entries queried with server-side orderBy + limit(PUBLIC_TOP_LIMIT)"
    },
    "/posts/{postId}": {
      "schema": "ForumPost",
      "description": "Class forum posts"
    },
    "/periodicTests/{testId}": {
      "schema": "PeriodicTestSchedule",
      "description": "Periodic test schedule dates for countdown"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student and teacher profiles and credentials"
    }
  }
}
